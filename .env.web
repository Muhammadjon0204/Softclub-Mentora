# =============================================================================
# MentorTaskFlow — конфигурация ФРОНТЕНДА.
#
#   cp .env.web .env.web  &&  nano .env.web
#
#   docker compose --env-file .env.web -f docker-compose.web.yml up -d --build
#
# У бэкенда свой файл — .env.api. Они полностью независимы: правка или
# удаление строки здесь не может сломать бэкенд и наоборот.
#
# Переменных мало, потому что контейнер только раздаёт статику: ни базы, ни
# секретов, ни обращений к другим контейнерам у него нет.
#
# ─── Связь с .env.api ────────────────────────────────────────────────────
#
#   VITE_API_BASE_URL       здесь  ←→  адрес api.<домен> у бэкенда
#   адрес, где открыт фронт        ←→  Cors__AllowedOrigins__0  в .env.api
#
#   Меняете домен — правьте оба файла. Расхождение выглядит как «запросы из
#   браузера не уходят, в консоли CORS».
#
# Файл лежит в репозитории и заполняется прямо на сервере. Чтобы git pull не
# затирал ваши значения, там один раз делается:
#   git update-index --skip-worktree .env.api .env.web
# =============================================================================

# --------------------------------------------
# Порт на хосте
#
#   <домен> ──▶ 127.0.0.1:8092 ──▶ mentora-web
#
# Привязка к 127.0.0.1 обязательна: Docker пишет правила напрямую в iptables,
# в обход ufw, и порт без явного 127.0.0.1 открыт всему интернету, даже если
# ufw говорит обратное. Наружу порт отдаёт хостовый nginx.
#
# Занято на сервере: 2358 3001-3004 3010 3011 5000 5401-5403 5407 5409 5459
#                    6380 8001-8003 8007 8082 8085 8347 8348 8999
#                    плюс 8093 и 9092 у бэкенда этого же проекта
# --------------------------------------------
WEB_EXTERNAL_PORT=127.0.0.1:8092

# --------------------------------------------
# Имя контейнера
# --------------------------------------------
WEB_CONTAINER_NAME=mentora-web

# --------------------------------------------
# DockerHub
# --------------------------------------------
DOCKERHUB_USERNAME=tajievolimjon
WEB_IMAGE_NAME=mentora-web
IMAGE_TAG=latest

# --------------------------------------------
# Адрес API
#
# ВАЖНО. Значение вшивается в JavaScript на этапе СБОРКИ образа, а не читается
# при запуске контейнера. Поменять его и сделать `restart` недостаточно —
# нужна пересборка:
#
#   docker compose --env-file .env.web -f docker-compose.web.yml up -d --build
#
# Должно совпадать с тем, как API виден снаружи через хостовый nginx, включая
# путь /api/v1. Без домена (проверка по IP): http://204.168.250.48:8093
# --------------------------------------------
VITE_API_BASE_URL=https://tmsapi.softclub.tj
