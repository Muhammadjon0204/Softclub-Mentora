{
  "expo": {
    "name": "RAVAND",
    "slug": "ravand-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "ravand",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "tj.softclub.ravand",
      "icon": "./assets/brand/icon.png",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "tj.softclub.ravand",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/brand/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/icon-512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/brand/splash.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0b1b3a",
            "image": "./assets/brand/splash.png"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
