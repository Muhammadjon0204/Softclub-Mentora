# =============================================================================
# MentorTaskFlow — конфигурация БЭКЕНДА.
#
#   nano .env.api      # заполнить и заглянуть в комментарии
#
#   docker compose --env-file .env.api -f docker-compose.api.yml up -d
#
# У фронта свой файл — .env.web. Они полностью независимы: правка или
# удаление строки здесь не может сломать фронт и наоборот.
#
# Читается дважды, и это намеренно:
#   1. Docker Compose подставляет ${...} в docker-compose.api.yml (порты, имена);
#   2. он же целиком уезжает в контейнеры через env_file, поэтому ключи .NET
#      записаны через два подчёркивания (Auth__JwtSigningKey = Auth:JwtSigningKey).
#
# ─── Две строки связаны с .env.web ──────────────────────────────────────
#
#   Cors__AllowedOrigins__0   здесь  ←→  адрес, по которому открыт фронт
#   адрес api.<домен>                ←→  VITE_API_BASE_URL  в .env.web
#
#   Меняете домен — правьте оба файла. Расхождение выглядит как «запросы из
#   браузера не уходят, в консоли CORS».
#
# Файл лежит в репозитории и заполняется прямо на сервере. Чтобы git pull не
# затирал ваши значения, там один раз делается:
#   git update-index --skip-worktree .env.api .env.web
# =============================================================================

# --------------------------------------------
# Окружение
# --------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# --------------------------------------------
# Порты на хосте
#
#   api.<домен>       ──▶ 127.0.0.1:8093   mentora-api
#   storage.<домен>   ──▶ 127.0.0.1:9092   mentora-minio
#   (<домен> ──▶ 8092 mentora-web — это .env.web)
#
# Привязка к 127.0.0.1 обязательна: Docker пишет правила напрямую в iptables,
# в обход ufw, и порт без явного 127.0.0.1 открыт всему интернету, даже если
# ufw говорит обратное. Наружу порты отдаёт хостовый nginx.
#
# Занято на сервере: 2358 3001-3004 3010 3011 5000 5401-5403 5407 5409 5459
#                    6380 8001-8003 8007 8082 8085 8347 8348 8999
# --------------------------------------------
API_EXTERNAL_PORT=127.0.0.1:8093

# MinIO. Presigned-ссылки открывает браузер пользователя, поэтому наружу его
# отдаёт хостовый nginx — поддоменом storage.<домен> на этот порт.
# Без домена пришлось бы ставить 0.0.0.0, чтобы браузер достучался напрямую.
MINIO_EXTERNAL_PORT=127.0.0.1:9092

# Postgres наружу не публикуется вообще: к нему ходят только контейнеры
# по внутренней сети.

# --------------------------------------------
# Имена контейнеров
# --------------------------------------------
API_CONTAINER_NAME=mentora-api
WORKER_CONTAINER_NAME=mentora-worker
MIGRATOR_CONTAINER_NAME=mentora-migrator
DB_CONTAINER_NAME=mentora-db
MINIO_CONTAINER_NAME=mentora-minio

# --------------------------------------------
# DockerHub
# --------------------------------------------
DOCKERHUB_USERNAME=muhammadjon0204
API_IMAGE_NAME=mentora-api
IMAGE_TAG=latest

# --------------------------------------------
# Адреса
#
# Фронт и API обязаны быть в одной «зоне»: либо оба на поддоменах одного корня,
# либо оба на одном IP. Смешивать нельзя — куки mtf_rt и mtf_csrf выставлены
# host-only и с SameSite=Strict, поэтому между доменом и IP они не ходят, а
# https-страница вдобавок не может обращаться к http-адресу.
#
# Пока домена нет, для проверки годится IP по http — тогда здесь:
#   API_EXTERNAL_PORT=0.0.0.0:8093        (браузер идёт в API напрямую)
#   MINIO_EXTERNAL_PORT=0.0.0.0:9092
#   Auth__RequireSecureCookies=false
#   и http-адреса в Auth__AppBaseUrl, Notifications__AppBaseUrl,
#   Cors__AllowedOrigins__0, Storage__PublicEndpoint;
# а в .env.web — VITE_API_BASE_URL=http://204.168.250.48:8093
# --------------------------------------------

# --------------------------------------------
# PostgreSQL
#
# Три роли с непересекающимися правами (ТЗ 12.6):
#   mentortaskflow_app        — приложение, без DDL
#   mentortaskflow_migrator   — миграции и bootstrap, полный DDL
#   mentortaskflow_retention  — джоба очистки, только DELETE где положено
#
# Пароли задаёте вы — ничего не генерируется автоматически. Удобно взять вывод
# `openssl rand -base64 32`, но подойдёт любое своё значение. Роли с этими
# паролями создаёт scripts/db/01-roles.sh при ПЕРВОМ запуске пустого тома;
# на уже существующей базе их надо сменить вручную — см. DEPLOY.md.
#
# Не используйте символы ; и # — первый ломает строку подключения Npgsql,
# второй начинает комментарий в этом файле. base64 их не выдаёт.
#
# Каждый пароль пишется ровно один раз: строки подключения docker-compose.api.yml
# собирает из этих переменных сам.
# --------------------------------------------
POSTGRES_DB=mentortaskflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=c6cae48f7a186205610a95190ca511723434d994fd3beaf4

APP_DB_PASSWORD=18ee61efa8b5a9b9088e0ab1d516a5ba8cbd40cd9b8788c4
MIGRATOR_DB_PASSWORD=7462edc80d8a74ab5e487c932ddaa1f59e48b644c1d857ac
RETENTION_DB_PASSWORD=6e7b96bc8f379f71f404388b7a262284bcaae9ef380acaf6

# Миграции применяет только mentora-migrator — отдельным контейнером, один раз
# за деплой. Несколько реплик API, стартующих одновременно, дрались бы за
# блокировки схемы (DEPLOY-016). Менять не нужно.
Database__MigrateOnStartup=false
Database__ApplicationRole=mentortaskflow_app

# --------------------------------------------
# MinIO (S3-совместимое хранилище)
#
# Тоже пишется один раз: ключи доступа API (Storage__AccessKey/SecretKey) и
# внутренний адрес подставляет docker-compose.api.yml из этих двух переменных.
# --------------------------------------------
MINIO_ROOT_USER=e44964d7b80f947c
MINIO_ROOT_PASSWORD=6514a7e868516fc1528b3f25343430abfb999553e59d473b

Storage__Bucket=mentortaskflow
Storage__EnsureBucketOnStartup=true

# Две схемы, потому что адреса два. API ходит в MinIO по внутренней сети Docker,
# где TLS нет и не нужен, — там http. Браузер идёт через хостовый nginx с
# сертификатом — там https. Одним флагом не обойтись: с UseSsl=true API не
# соединится с MinIO, с false в ссылку попадёт http, который страница по https
# загрузить не имеет права.
Storage__UseSsl=false
Storage__PublicUseSsl=true

# PublicEndpoint — адрес, который попадает в presigned-ссылку и открывается
# в браузере пользователя. Хост входит в подпись, переписать его постфактум
# нельзя, поэтому он обязан совпадать с тем, как MinIO виден снаружи через
# хостовый nginx.
Storage__PublicEndpoint=https://tmsstorage.softclub.tj

# --------------------------------------------
# Аутентификация
# --------------------------------------------
# Минимум 256 бит: openssl rand -base64 48
Auth__JwtSigningKey=6a8098686ab6afbc1d4fdfed45a87ece0fc089e2076933afda9f7432f7ce848ad6d34cf80cd7a9257bd62a6069856db3

# Помечает куки mtf_rt и mtf_csrf флагом Secure — браузер тогда хранит их
# только по https. Для домена с сертификатом это правильное значение.
#
# Поставьте false, ТОЛЬКО если разворачиваете по http (на IP, без домена):
# Secure-куку браузер по http молча выбрасывает, и тогда логин проходит, а
# через 15 минут — срок жизни access-токена — refresh не находит куку и
# пользователя выкидывает без возможности войти.
Auth__RequireSecureCookies=true

# Базовый адрес SPA. Отсюда строятся ссылки «задать пароль» и «сбросить пароль»
# в письмах. Без слеша на конце.
Auth__AppBaseUrl=https://tms.softclub.tj

# Domain для куки mtf_csrf (только для неё — mtf_rt остаётся host-only).
# Фронт и API на разных поддоменах (tms./tmsapi.), а без Domain кука
# host-only: API её видит, но document.cookie на странице SPA — нет,
# X-CSRF-Token никогда не уходит, и refresh падает CSRF_VALIDATION_FAILED
# при каждом обновлении страницы. Значение — общий домен без поддомена и без
# точки в начале.
Auth__CsrfCookieDomain=softclub.tj

# --------------------------------------------
# CORS
#
# Точный origin фронта — схема, хост, при нестандартном порте и порт. Без слеша
# на конце. Фронт и API на разных поддоменах, значит браузер шлёт preflight и
# сверяет ответ с этим списком; ошибка здесь выглядит как «запрос не уходит».
#
# Этот же список проверяет заголовок Origin у /auth/refresh и /auth/logout
# (RequireCsrfAttribute), поэтому опечатка ломает и продление сессии.
#
# Wildcard недопустим — AllowCredentials его запрещает.
# --------------------------------------------
Cors__AllowedOrigins__0=https://tms.softclub.tj

# --------------------------------------------
# Bootstrap — только при первом запуске на пустой базе
#
# Пароля здесь нет намеренно: первый администратор получает одноразовую ссылку
# на установку пароля, и она печатается в лог контейнера mentora-migrator
# (AUTH-019, DEPLOY-024).
# --------------------------------------------
Bootstrap__OrganizationName=SoftClub Academy
Bootstrap__OrganizationSlug=softclub-academy
Bootstrap__HeadOfficeName=Филиал Профсоюз
Bootstrap__HeadOfficeCode=PROFSOYUZ
Bootstrap__HeadOfficeTimeZone=Asia/Dushanbe
Bootstrap__AdminEmail=tajiev0711@gmail.com

# --------------------------------------------
# Почта (SMTP)
#
# Значения читает только mentora-worker. Пустой SmtpHost уронит его на старте:
# настройка помечена [Required], и пустая строка перекрывает дефолт из
# appsettings.json. Если почта пока не нужна — оставьте localhost.
# --------------------------------------------
Notifications__SmtpHost=smtp.gmail.com
Notifications__SmtpPort=587
Notifications__SmtpUser=tajiev0711@gmail.com
Notifications__SmtpPassword=ydyp vloj ytpw iqgj
Notifications__SmtpUseSsl=true
Notifications__FromAddress=tajiev0711@gmail.com
Notifications__FromName=MentorTaskFlow Administration
Notifications__AppBaseUrl=https://tms.softclub.tj

# --------------------------------------------
# Telegram (опционально)
# --------------------------------------------
Telegram__Enabled=false
Telegram__BotUsername=mentortaskflow_bot
Telegram__BotToken=
Telegram__WebhookSecret=

# --------------------------------------------
# AI-сводки (опционально)
#
# С Enabled=false установка работает полностью, только POST /reports/ai-summary
# отвечает 404, а /health/ready показывает AI как degraded, не Unhealthy.
# --------------------------------------------
Ai__Enabled=false
Ai__ApiKey=
Ai__ModelId=claude-sonnet-5
Ai__PromptVersion=v1.0

# --------------------------------------------
# Метрики
#
# /metrics не требует аутентификации, поэтому границей служит сеть: по умолчанию
# пускаются только loopback и приватные диапазоны. Порт API привязан к 127.0.0.1,
# так что снаружи эндпоинт недостижим.
# --------------------------------------------
Metrics__Enabled=true
