# MentorTaskFlow — unified deployment configuration.
# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ── General ──────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=mentortaskflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=          # openssl rand -base64 32

# Connection strings (three non-overlapping roles per TZ 12.6).
CONNECTION_STRING_APP=Host=postgres;Port=5432;Database=mentortaskflow;Username=mentortaskflow_app;Password=CHANGE_ME
CONNECTION_STRING_MIGRATOR=Host=postgres;Port=5432;Database=mentortaskflow;Username=mentortaskflow_migrator;Password=CHANGE_ME

# ── MinIO (S3-compatible storage) ────────────────────────────────────────────
MINIO_ROOT_USER=            # openssl rand -hex 16
MINIO_ROOT_PASSWORD=        # openssl rand -base64 32
STORAGE_BUCKET=mentortaskflow
# Public endpoint for presigned URLs — the URL the browser hits to download files.
# If behind a reverse proxy: https://storage.yourdomain.com
STORAGE_PUBLIC_ENDPOINT=http://minio:9000

# ── Auth ─────────────────────────────────────────────────────────────────────
# At least 256 bits. Generate: openssl rand -base64 48
AUTH_JWT_SIGNING_KEY=

# ── CORS / Frontend origin ───────────────────────────────────────────────────
# The exact URL where the SPA is served. No trailing slash.
CORS_ALLOWED_ORIGIN=http://204.168.250.48

# ── Frontend ─────────────────────────────────────────────────────────────────
# Host port the SPA (nginx) listens on.
WEB_PORT=80

# ── Bootstrap (first run only) ───────────────────────────────────────────────
BOOTSTRAP_ORGANIZATION_NAME=SoftClub Academy
BOOTSTRAP_ORGANIZATION_SLUG=softclub-academy
BOOTSTRAP_HEAD_OFFICE_NAME=Филиал Профсоюз
BOOTSTRAP_HEAD_OFFICE_CODE=PROFSOYUZ
BOOTSTRAP_HEAD_OFFICE_TIMEZONE=Asia/Dushanbe
BOOTSTRAP_ADMIN_EMAIL=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@yourdomain.com

# ── Telegram (optional) ─────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── AI summaries (optional) ─────────────────────────────────────────────────
AI_ENABLED=false
AI_API_KEY=
AI_MODEL_ID=claude-sonnet-5
AI_PROMPT_VERSION=v1.0
