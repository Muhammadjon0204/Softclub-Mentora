# true  — все запросы перехватывает MSW (бэкенд не нужен)
# false — worker не регистрируется, запросы уходят на VITE_API_BASE_URL как есть
VITE_USE_MOCKS=false

# С моками достаточно относительного пути.
# Для реального бэкенда: VITE_API_BASE_URL=https://api.mentortaskflow.local/api/v1
VITE_API_BASE_URL=/api/v1
